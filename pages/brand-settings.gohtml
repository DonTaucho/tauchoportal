                            </div>
                        </div>
                        <span class="status-badge disconnected" data-brand-status>{{.I18n.T "brandSettings.notConnected"}}</span>
                    </div>
                    <div class="brand-details">
                        <div class="brand-detail-row">
                            <span class="brand-detail-label">{{.I18n.T "brandSettings.lastConnected"}}</span>
                            <span data-brand-last-connected>{{.I18n.T "brandSettings.neverConnected"}}</span>
                        </div>
                    </div>
                    <div class="brand-actions">
                        <button type="button" class="btn-connect brand-action-button" data-brand-action-button data-brand-action="connect" data-brand-id="govee">{{.I18n.T "brand.govee.connectButton"}}</button>
                        <span class="brand-note" data-brand-note hidden></span>
                    </div>
                </article>
                <article class="brand-card" data-brand-card data-brand-id="philips-hue" data-brand-title="{{.I18n.T "brand.philips-hue.title"}}" data-brand-description="{{.I18n.T "brand.philips-hue.description"}}" data-connect-label="{{.I18n.T "brand.philips-hue.connectButton"}}" data-disconnect-label="{{.I18n.T "brand.philips-hue.disconnectButton"}}">
