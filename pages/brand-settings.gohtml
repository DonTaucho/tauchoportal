{{define "page"}}{{template "base" .}}{{end}}

{{define "head"}}
<link rel="stylesheet" href="/css/modals.css">
<link rel="stylesheet" href="/css/account-settings.css">
<script src="/js/brand-settings.js" defer></script>
<style>
    .brand-settings-page .settings-content {
        width: 100%;
    }

    .brands-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1rem;
    }

    .brand-card {
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        padding: 1.1rem;
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
        min-height: 250px;
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.04);
    }

    .brand-card.is-connected {
        border-color: #a5d6a7;
        background: #f9fffa;
    }

    .brand-card.is-unsupported {
        border-color: #ffd54f;
        background: #fffdf5;
    }

    .brand-card.is-external {
        border-color: #bbdefb;
        background: #f8fbff;
    }

    .brand-card-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.75rem;
    }

    .brand-card-identity {
        display: flex;
        gap: 0.85rem;
        min-width: 0;
    }

    .brand-logo {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: linear-gradient(135deg, #4CAF50, #2e7d32);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        letter-spacing: 0.04em;
        font-size: 0.95rem;
        flex-shrink: 0;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.2);
    }

    .brand-card.is-unsupported .brand-logo {
        background: linear-gradient(135deg, #ffb300, #fb8c00);
    }

    .brand-card.is-external .brand-logo {
        background: linear-gradient(135deg, #42a5f5, #1e88e5);
    }

    .brand-name {
        margin: 0;
        font-size: 1rem;
        color: #1f2937;
    }

    .brand-description {
        margin: 0.35rem 0 0;
        color: #667085;
        font-size: 0.86rem;
        line-height: 1.45;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding: 0.28rem 0.72rem;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        white-space: nowrap;
    }

    .status-badge.connected {
        background: #e8f5e9;
        color: #2e7d32;
        border: 1px solid #a5d6a7;
    }

    .status-badge.disconnected {
        background: #f5f5f5;
        color: #7a7a7a;
        border: 1px solid #dddddd;
    }

    .status-badge.info {
        background: #eef4ff;
        color: #245ea8;
        border: 1px solid #bfd8ff;
    }

    .status-badge.warn {
        background: #fff3cd;
        color: #8a5a00;
        border: 1px solid #ffe08a;
    }

    .brand-details {
        display: grid;
        gap: 0.45rem;
        font-size: 0.84rem;
        color: #556070;
    }

    .brand-detail-row {
        display: flex;
        justify-content: space-between;
        gap: 0.75rem;
    }

    .brand-detail-label {
        color: #6b7280;
        font-weight: 600;
    }

    .brand-actions {
        margin-top: auto;
        display: flex;
        gap: 0.65rem;
        flex-wrap: wrap;
    }

    .brand-action-button {
        margin-top: 0;
    }

    .brand-action-button:disabled,
    .btn-disconnect:disabled {
        opacity: 0.55;
        cursor: not-allowed;
    }

    .brand-note {
        display: inline-flex;
        align-items: center;
        font-size: 0.82rem;
        color: #6b7280;
        min-height: 2.2rem;
    }

    .brand-note.warn {
        color: #9a6700;
    }

    .oauth-qr-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 180px;
        margin-bottom: 1rem;
    }

    .oauth-qr-container img,
    .oauth-qr-container svg {
        max-width: 220px;
        max-height: 220px;
    }

    .oauth-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        width: 100%;
        box-sizing: border-box;
    }

    .modal-note {
        margin: 0 0 1rem;
        color: #667085;
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .modal-note.warning {
        color: #9a3412;
        background: #fff7ed;
        border: 1px solid #fed7aa;
        padding: 0.8rem 0.9rem;
        border-radius: 8px;
    }

    .field-hint {
        display: block;
        margin-top: 0.35rem;
        font-size: 0.78rem;
        color: #777;
    }

    @media (max-width: 768px) {
        .brand-settings-page .settings-container,
        .brand-settings-page.settings-container {
            padding: 1rem;
        }

        .brand-card {
            min-height: unset;
        }

        .brand-card-header,
        .brand-detail-row {
            flex-direction: column;
        }

        .status-badge {
            align-self: flex-start;
        }

        .brand-actions {
            flex-direction: column;
        }

        .brand-actions button,
        .brand-actions a {
            width: 100%;
        }
    }
</style>
{{end}}

{{define "content"}}
<div class="settings-container brand-settings-page">
    <div class="settings-content">
        <section class="settings-section active">
            <div class="section-header">
                <h2>{{.I18n.T "brandSettings.title"}}</h2>
                <p>{{.I18n.T "brandSettings.description"}}</p>
            </div>
            <div id="brandSettingsMsg" class="status-msg">{{.I18n.T "brandSettings.loading"}}</div>
            <div
                id="brandSettingsStrings"
                hidden
                data-loading-message="{{.I18n.T "brandSettings.loading"}}"
                data-load-error-message="{{.I18n.T "brandSettings.loadError"}}"
                data-connected-label="{{.I18n.T "brandSettings.connected"}}"
                data-not-connected-label="{{.I18n.T "brandSettings.notConnected"}}"
                data-never-connected="{{.I18n.T "brandSettings.neverConnected"}}"
                data-unsupported-label="{{.I18n.T "brandSettings.status.unsupported"}}"
                data-external-label="{{.I18n.T "brandSettings.status.external"}}"
                data-saved-message="{{.I18n.T "brandSettings.status.saved"}}"
                data-disconnected-message="{{.I18n.T "brandSettings.status.disconnected"}}"
                data-connected-success-message="{{.I18n.T "brandSettings.status.connectedSuccess"}}"
                data-oauth-unavailable-message="{{.I18n.T "brandSettings.modal.oauthUnavailable"}}"
                data-auth-token-hint-message="{{.I18n.T "brandSettings.modal.authTokenHint"}}"
                data-optional-token-message="{{.I18n.T "brandSettings.modal.optionalToken"}}"
                data-confirm-disconnect-description="{{.I18n.T "brandSettings.modal.confirmDisconnectDescription"}}"
                data-api-key-required-message="{{.I18n.T "brandSettings.validation.apiKeyRequired"}}"
                data-ip-required-message="{{.I18n.T "brandSettings.validation.ipRequired"}}"
                data-connect-failed-message="{{.I18n.T "brandSettings.error.connectFailed"}}"
                data-save-failed-message="{{.I18n.T "brandSettings.error.saveFailed"}}"
                data-disconnect-failed-message="{{.I18n.T "brandSettings.error.disconnectFailed"}}"></div>
            <div id="brandsGrid" class="brands-grid">
                <article class="brand-card" data-brand-card data-brand-id="govee" data-brand-title="{{.I18n.T "brand.govee.title"}}" data-brand-description="{{.I18n.T "brand.govee.description"}}" data-connect-label="{{.I18n.T "brand.govee.connectButton"}}" data-disconnect-label="{{.I18n.T "brand.govee.disconnectButton"}}">
