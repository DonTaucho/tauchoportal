{{define "page"}}{{template "channels" .}}{{end}}

{{define "channelshead"}}{{end}}

{{define "channelscontent"}}
        <div id="view-list" class="view channels-view">
            <div class="page-header">
                <div class="page-header-top">
                    <div>
                        <h1><img src="/image/channels_s.png"> Channels</h1>
                        <p>Live streaming accounts monitored by the polling service. Add channels via the sidebar on the left.</p>
                    </div>
                </div>
                <div class="stats-row" id="statsRow"></div>
            </div>
            <div class="channels-list" id="channelsList"></div>
            <div class="empty-state" id="emptyState" style="display:none">
                <div class="empty-icon"><img src="/image/waiting_s.png" /></div>
                <h2>No channels yet</h2>
                <p>Choose a platform on the left and add the channels you want to monitor.</p>
            </div>
        </div>
{{end}}

{{define "scripts"}}
<script src="/js/channels-list.js"></script>
{{end}}
